---
import BaseLayout from "@layouts/BaseLayout.astro";
import { locations, siteConfig, whatsappUrl } from "../environments/env";
---

<BaseLayout
  title="Contact Us"
  description="Get a quote from Jagdamba Nursery for Selection No. 1, Korean, or Neelgiri grass — call, WhatsApp, or send an enquiry."
>
  <section class="mx-auto max-w-5xl px-6 py-20 grid md:grid-cols-2 gap-14">
    <div data-reveal>
      <h1 class="text-4xl">Get a Quote</h1>
      <p class="mt-4 text-ink/70">
        Tell us the variety, the area you need to cover, and your location —
        we'll get back to you with pricing and availability.
      </p>

      <div class="mt-8 space-y-3 text-sm rounded-3xl bg-forest/5 p-6">
        <p><span class="text-ink/50">Phone:</span> {siteConfig.phoneDisplay}</p>
        {siteConfig.email && <p><span class="text-ink/50">Email:</span> {siteConfig.email}</p>}
        <p><span class="text-ink/50">Address:</span> {siteConfig.address}</p>
        <p><span class="text-ink/50">Hours:</span> {siteConfig.hours}</p>
      </div>

      <a
        href={whatsappUrl}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-grass px-7 py-3.5 text-sm font-medium text-white hover:bg-forest hover:-translate-y-0.5 transition-all"
      >
        Chat on WhatsApp
      </a>
    </div>

    <!--
      Replace the form "action" below with your Formspree endpoint
      (or any form backend) since GitHub Pages can't process form
      submissions on its own. https://formspree.io has a free tier.
    -->
    <form
      action="https://formspree.io/f/YOUR_FORM_ID"
      method="POST"
      class="space-y-5 rounded-4xl bg-white shadow-soft p-8"
      data-reveal
    >
      <div>
        <label for="name" class="block text-sm mb-1">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-xl border border-forest/15 bg-paper px-4 py-2.5 text-sm focus:border-grass outline-none transition-colors"
        />
      </div>
      <div>
        <label for="phone" class="block text-sm mb-1">Phone</label>
        <input
          id="phone"
          name="phone"
          type="tel"
          required
          class="w-full rounded-xl border border-forest/15 bg-paper px-4 py-2.5 text-sm focus:border-grass outline-none transition-colors"
        />
      </div>
      <div>
        <label for="variety" class="block text-sm mb-1">Grass variety</label>
        <select
          id="variety"
          name="variety"
          class="w-full rounded-xl border border-forest/15 bg-paper px-4 py-2.5 text-sm focus:border-grass outline-none transition-colors"
        >
          <option>Not sure — please advise</option>
          <option>Selection No. 1</option>
          <option>Korean</option>
          <option>Neelgiri</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm mb-1">Details</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Area to cover, location, timeline..."
          class="w-full rounded-xl border border-forest/15 bg-paper px-4 py-2.5 text-sm focus:border-grass outline-none transition-colors"
        ></textarea>
      </div>
      <button
        type="submit"
        class="w-full rounded-full bg-forest px-6 py-3.5 text-sm font-medium text-paper hover:bg-grass transition-colors"
      >
        Send Enquiry
      </button>
    </form>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20" aria-labelledby="visit-us-heading">
    <div class="mb-8 max-w-2xl" data-reveal>
      <p class="text-sm font-medium uppercase tracking-widest text-grass">Visit us</p>
      <h2 id="visit-us-heading" class="mt-2 text-3xl">Find our shop and farm</h2>
      <p class="mt-3 text-ink/70">
        Visit Jagdamba Pesticides for enquiries, or contact us before visiting Jagdamba Farm for grass availability.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {locations.map((location) => (
        <article class="overflow-hidden rounded-3xl bg-white shadow-soft" data-reveal>
          <iframe
            title={`Map showing ${location.name}`}
            src={`https://www.google.com/maps?q=${encodeURIComponent(location.name + " " + location.address)}&output=embed`}
            class="h-64 w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <div class="p-6">
            <h3 class="text-xl">{location.name}</h3>
            <p class="mt-2 text-sm text-ink/70">{location.address}</p>
            <a
              href={location.mapUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-5 inline-flex rounded-full bg-forest px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-grass"
            >
              Get directions <span class="sr-only">to {location.name}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
