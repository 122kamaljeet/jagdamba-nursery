---
import BaseLayout from "@layouts/BaseLayout.astro";
import CTAButton from "@components/CTAButton.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "../../environments/env";

export async function getStaticPaths() {
  const varieties = await getCollection("varieties");
  return varieties.map((v) => ({
    params: { slug: v.data.slug },
    props: { variety: v },
  }));
}

const { variety } = Astro.props;
const { Content } = await render(variety);
const { name, tagline, idealFor, sunlight, colour, establishment, maintenance, details, image } =
  variety.data;

const infoItems =
  details.length > 0
    ? details
    : [
        ...(Array.isArray(idealFor) && idealFor.length
          ? [{ label: "Ideal for", value: idealFor.join(", ") }]
          : []),
        ...(sunlight ? [{ label: "Sunlight", value: sunlight }] : []),
        ...(colour ? [{ label: "Colour", value: colour }] : []),
        ...(establishment ? [{ label: "Establishment", value: establishment }] : []),
        ...(maintenance ? [{ label: "Maintenance", value: maintenance }] : []),
      ];
---

<BaseLayout
  title={name}
  description={`${tagline} Grown fresh at Jagdamba Nursery in Ambala, Haryana.`}
>
  <section class="mx-auto max-w-4xl px-6 py-20">
    <div class="aspect-[16/9] rounded-4xl overflow-hidden shadow-soft" data-reveal>
      <img src={image} alt={`${name} lawn grass`} class="h-full w-full object-cover" />
    </div>

    <h1 class="mt-8 text-4xl" data-reveal>{name}</h1>
    <p class="mt-2 text-lg text-ink/70" data-reveal>{tagline}</p>

    <dl class="mt-8 grid gap-6 text-sm md:grid-cols-2" data-reveal>
      {infoItems.map(({ label, value }) => (
        <div class="rounded-2xl bg-forest/5 p-5 max-w-[420px] w-full justify-self-center">
          <dt class="text-ink/50">{label}</dt>
          <dd class="mt-1 break-words leading-relaxed">{value}</dd>
        </div>
      ))}
    </dl>

    <div class="prose prose-neutral mt-10 max-w-prose" data-reveal>
      <Content />
    </div>

    <div class="mt-10" data-reveal>
      <CTAButton href={`/contact`}>Request a Quote for {name}</CTAButton>
    </div>
  </section>
</BaseLayout>
