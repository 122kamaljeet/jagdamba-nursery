---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "@layouts/BaseLayout.astro";

const galleryDirectory = path.join(process.cwd(), "public", "media", "gallery");
const imageExtensions = new Set([".avif", ".gif", ".jpeg", ".jpg", ".png", ".webp"]);
const videoExtensions = new Set([".m4v", ".mp4", ".ogv", ".webm"]);

const findMediaFiles = (directory: string): string[] =>
  fs.readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const entryPath = path.join(directory, entry.name);
    return entry.isDirectory() ? findMediaFiles(entryPath) : [entryPath];
  });

const media = findMediaFiles(galleryDirectory)
  .map((filePath) => {
    const extension = path.extname(filePath).toLowerCase();
    const type = imageExtensions.has(extension)
      ? "image"
      : videoExtensions.has(extension)
        ? "video"
        : null;
    const relativePath = path.relative(galleryDirectory, filePath);
    const fileName = path.basename(filePath);

    return type
      ? {
          type,
          name: fileName,
          src: `/media/gallery/${relativePath
            .split(path.sep)
            .map((segment) => encodeURIComponent(segment))
            .join("/")}`,
          alt: path
            .basename(fileName, extension)
            .replace(/[-_]+/g, " ")
            .replace(/\s+/g, " ")
            .trim(),
        }
      : null;
  })
  .filter((item): item is NonNullable<typeof item> => item !== null)
  .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

const photos = media.filter((item) => item.type === "image");
const videos = media.filter((item) => item.type === "video");
---

<BaseLayout
  title="Gallery"
  description="Photos and video from our fields and finished lawn projects using Jagdamba Nursery grass."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h1 class="text-4xl" data-reveal>Gallery</h1>
    <p class="mt-4 text-ink/70 max-w-prose" data-reveal>
      A look at our fields and some of the lawns our grass has gone into.
    </p>

    {videos.length > 0 && (
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {videos.map((video) => (
          <div class="overflow-hidden rounded-4xl shadow-soft" data-reveal>
            <video
              class="w-full aspect-video object-cover bg-forest/10"
              controls
              preload="metadata"
              playsinline
            >
              <source src={video.src} />
              Your browser does not support this video format.
            </video>
          </div>
        ))}
      </div>
    )}

    <div class="mt-12 grid sm:grid-cols-2 md:grid-cols-3 gap-4">
      {photos.map((photo) => (
        <button
          type="button"
          class="group aspect-square overflow-hidden rounded-3xl shadow-card text-left outline-none"
          data-reveal
          data-lightbox-trigger
          data-src={photo.src}
          data-alt={photo.alt}
          aria-label={`Open image: ${photo.alt}`}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
        </button>
      ))}
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/80 p-4" aria-hidden="true">
    <button type="button" class="absolute inset-0 cursor-default" data-close-lightbox aria-label="Close image preview"></button>
    <div class="relative max-h-[90vh] max-w-5xl overflow-hidden rounded-3xl bg-paper shadow-2xl">
      <button type="button" class="absolute right-3 top-3 z-10 rounded-full bg-ink/80 px-3 py-1.5 text-sm text-paper" data-close-lightbox aria-label="Close image">
        Close
      </button>
      <img id="lightbox-image" src="" alt="" class="max-h-[90vh] w-auto max-w-full object-contain" />
    </div>
  </div>

  <script>
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightbox-image");
    const triggerButtons = document.querySelectorAll("[data-lightbox-trigger]");
    const closeButtons = document.querySelectorAll("[data-close-lightbox]");

    const closeLightbox = () => {
      lightbox?.classList.add("hidden");
      lightbox?.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
      lightbox?.setAttribute("aria-hidden", "true");
    };

    triggerButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const target = button;
        if (lightboxImage && lightbox) {
          lightboxImage.src = target.getAttribute("data-src") || "";
          lightboxImage.alt = target.getAttribute("data-alt") || "";
        }
        lightbox?.classList.remove("hidden");
        lightbox?.classList.add("flex");
        document.body.classList.add("overflow-hidden");
        lightbox?.setAttribute("aria-hidden", "false");
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeLightbox);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });

    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });
  </script>
</BaseLayout>
