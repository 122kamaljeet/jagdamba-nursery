---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="Guides"
  description="Grass and lawn care guides from Jagdamba Nursery, written for Haryana's climate and conditions."
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-grass">
        Advice from the field
      </p>
      <h1 class="mt-4 text-5xl md:text-6xl">Guides</h1>
      <p class="mt-5 text-lg text-ink/70">
        Practical notes on choosing and maintaining lawn grass in this region.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <button
        type="button"
        class="filter-chip is-active rounded-full border border-forest bg-forest px-4 py-2 text-sm text-paper shadow-sm transition-colors"
        data-filter="all"
      >
        All guides
      </button>
      {allTags.map((topic) => (
        <button
          type="button"
          class="filter-chip rounded-full border border-forest/15 bg-white px-4 py-2 text-sm text-ink/70 shadow-sm transition-colors hover:border-forest/30"
          data-filter={topic}
        >
          {topic}
        </button>
      ))}
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-[1.4fr_0.6fr]">
      <div id="guide-list" class="space-y-6">
        {posts.map((post) => (
          <article
            class="guide-card rounded-[28px] border border-forest/10 bg-white p-6 shadow-card transition-transform duration-200 hover:-translate-y-1 md:p-8"
            data-tags={post.data.tags.join(",")}
          >
            <div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-[0.12em] text-grass/80">
              <span>Guide</span>
              <span class="h-1 w-1 rounded-full bg-forest/30"></span>
              <time datetime={post.data.date.toISOString()}>
                {new Date(post.data.date).toLocaleDateString("en-IN", {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                })}
              </time>
            </div>

            <h2 class="mt-5 text-3xl md:text-4xl">
              <a href={`/blogs/${post.data.slug}`} class="text-forest hover:text-grass">
                {post.data.title}
              </a>
            </h2>

            <p class="mt-4 max-w-2xl text-base leading-7 text-ink/70">
              {post.data.description}
            </p>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-forest/10 pt-5">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full bg-forest/5 px-2.5 py-1 text-[10px] uppercase tracking-[0.12em] text-forest/70">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={`/blogs/${post.data.slug}`}
                class="inline-flex items-center gap-2 rounded-full bg-grass px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-forest"
              >
                Read article →
              </a>
            </div>
          </article>
        ))}
      </div>

      <aside class="space-y-6">
        <div class="rounded-[28px] bg-forest p-6 text-paper shadow-card md:p-7">
          <p class="text-sm uppercase tracking-[0.14em] text-paper/80">Need a recommendation?</p>
          <h3 class="mt-4 text-2xl text-paper">Choose the right grass for your lawn</h3>
          <p class="mt-3 text-sm leading-6 text-paper/80">
            Tell us your space, sunlight, and maintenance level, and we’ll suggest the best fit.
          </p>
          <a
            href="/contact"
            class="mt-6 inline-flex items-center justify-center rounded-full bg-paper px-5 py-3 text-sm font-medium text-forest transition-colors hover:bg-paper/90"
          >
            Talk to us
          </a>
        </div>

        <div class="rounded-[28px] border border-forest/10 bg-white p-6 shadow-card md:p-7">
          <h3 class="text-2xl">Popular picks</h3>
          <ul class="mt-5 space-y-4 text-sm text-ink/70">
            <li class="border-b border-forest/10 pb-3">
              <a href="/varieties/selection-no-1" class="hover:text-grass">Selection No. 1</a>
            </li>
            <li class="border-b border-forest/10 pb-3">
              <a href="/varieties/korean" class="hover:text-grass">Korean grass</a>
            </li>
            <li>
              <a href="/varieties/neelgiri" class="hover:text-grass">Neelgiri grass</a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll(".filter-chip");
    const guideCards = document.querySelectorAll(".guide-card");

    function applyFilter(activeFilter) {
      guideCards.forEach((card) => {
        const tags = (card.getAttribute("data-tags") || "").split(",");
        const matches = activeFilter === "all" || tags.includes(activeFilter);
        card.style.display = matches ? "block" : "none";
      });

      filterButtons.forEach((button) => {
        const isActive = button.dataset.filter === activeFilter;
        button.classList.toggle("is-active", isActive);
        button.classList.toggle("border-forest", isActive);
        button.classList.toggle("bg-forest", isActive);
        button.classList.toggle("text-paper", isActive);
        button.classList.toggle("border-forest/15", !isActive);
        button.classList.toggle("bg-white", !isActive);
        button.classList.toggle("text-ink/70", !isActive);
      });

      const url = new URL(window.location.href);
      if (activeFilter === "all") {
        url.searchParams.delete("tag");
      } else {
        url.searchParams.set("tag", activeFilter);
      }
      window.history.replaceState({}, "", url);
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        applyFilter(button.dataset.filter || "all");
      });
    });

    const initialTag = new URL(window.location.href).searchParams.get("tag");
    if (initialTag) {
      applyFilter(initialTag);
    }
  </script>
</BaseLayout>
