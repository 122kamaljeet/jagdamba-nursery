---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedDate = new Date(post.data.date).toLocaleDateString("en-IN", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-grass">
        Guide
      </p>
      <h1 class="mt-4 text-4xl md:text-5xl">{post.data.title}</h1>
      <div class="mt-5 flex items-center justify-center gap-3 text-sm text-ink/60">
        <time datetime={post.data.date.toISOString()}>{publishedDate}</time>
        <span class="h-1 w-1 rounded-full bg-forest/30"></span>
        <span>Jagdamba Nursery</span>
      </div>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(260px,0.75fr)]">
      <div
        class="rounded-[28px] border border-forest/10 bg-white p-6 shadow-card md:p-8 lg:p-10"
      >
        <div class="space-y-6 text-base leading-8 text-ink/75">
          <Content />
        </div>
      </div>

      <aside class="space-y-6">
        <div class="rounded-[28px] bg-forest p-6 text-paper shadow-card md:p-7">
          <p class="text-sm uppercase tracking-[0.14em] text-paper/80">Need advice?</p>
          <h2 class="mt-3 text-2xl text-paper">Choose the right grass</h2>
          <p class="mt-3 text-sm leading-6 text-paper/80">
            Tell us about your lawn and we’ll suggest the best grass for your area and upkeep routine.
          </p>
          <a
            href="/contact"
            class="mt-6 inline-flex items-center justify-center rounded-full bg-paper px-5 py-3 text-sm font-medium text-forest transition-colors hover:bg-paper/90"
          >
            Talk to us
          </a>
        </div>

        <div class="rounded-[28px] border border-forest/10 bg-white p-6 shadow-card md:p-7">
          <h3 class="text-xl">Popular guides</h3>
          <ul class="mt-5 space-y-4 text-sm text-ink/70">
            <li class="border-b border-forest/10 pb-3">
              <a href="/blogs/best-grass-for-haryana-climate" class="hover:text-grass">
                Best grass for Haryana climate
              </a>
            </li>
            <li class="border-b border-forest/10 pb-3">
              <a href="/blogs/korean-vs-selection-no-1" class="hover:text-grass">
                Korean vs Selection No. 1
              </a>
            </li>
            <li>
              <a href="/blogs/neelgiri-for-large-open-areas" class="hover:text-grass">
                Neelgiri for large spaces
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
