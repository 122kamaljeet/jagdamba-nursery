---
import { siteConfig } from "../environments/env";

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const siteUrl = siteConfig.siteUrl;
const canonical = new URL(path, siteUrl).toString();
const pageTitle = `${title} | ${siteConfig.name}`;
const logoUrl = new URL(siteConfig.logo, siteUrl).toString();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "GardenStore",
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  description: siteConfig.description,
  url: siteUrl,
  logo: logoUrl,
  image: logoUrl,
  telephone: siteConfig.phoneDisplay,
  ...(siteConfig.email ? { email: siteConfig.email } : {}),
  address: {
    "@type": "PostalAddress",
    streetAddress: "Manka Manki",
    addressLocality: "Ambala",
    addressRegion: "Haryana",
    addressCountry: "IN",
  },
  areaServed: "Haryana, India",
  makesOffer: [
    { "@type": "Offer", itemOffered: { "@type": "Product", name: "Selection No. 1 Grass" } },
    { "@type": "Offer", itemOffered: { "@type": "Product", name: "Korean Grass" } },
    { "@type": "Offer", itemOffered: { "@type": "Product", name: "Neelgiri Grass" } },
  ],
};
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href={siteConfig.logo} type="image/png" />
<meta name="author" content={siteConfig.name} />
<meta name="robots" content="index, follow" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={logoUrl} />
<meta property="og:image:alt" content={siteConfig.name} />

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={logoUrl} />

<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
