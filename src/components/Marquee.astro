---
interface Props {
  items: string[];
}
const { items } = Astro.props;
const looped = [...items, ...items];
---

<div class="overflow-hidden border-y border-forest/10 bg-forest/5 py-3">
  <div class="marquee-track gap-10 text-sm text-forest/70 whitespace-nowrap">
    {looped.map((item) => (
      <span class="flex items-center gap-2 px-4">
        <span class="h-1.5 w-1.5 rounded-full bg-grass"></span>
        {item}
      </span>
    ))}
  </div>
</div>
