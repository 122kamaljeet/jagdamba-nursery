---
const links = [
  { href: "/jagdamba-nursery/", label: "Home" },
  { href: "/jagdamba-nursery/about", label: "About Us" },
  { href: "/jagdamba-nursery/varieties", label: "Our Grass" },
  { href: "/jagdamba-nursery/gallery", label: "Gallery" },
  { href: "/jagdamba-nursery/blog", label: "Guides" },
  { href: "/jagdamba-nursery/contact", label: "Contact" },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 px-4 pt-4">
  <div
    class="relative mx-auto max-w-6xl rounded-3xl bg-white/80 backdrop-blur-md border border-forest/10 shadow-card px-5 py-3 md:flex md:items-center md:justify-between md:rounded-full md:px-6"
  >
    <div class="flex items-center justify-between gap-4">
      <a href="/jagdamba-nursery/" class="font-display text-lg text-forest">
        Jagdamba <span class="text-grass">Nursery</span>
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-forest hover:bg-forest/10 md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="sr-only">Menu</span>
        <span class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="h-0.5 w-5 bg-current"></span>
          <span class="h-0.5 w-5 bg-current"></span>
          <span class="h-0.5 w-5 bg-current"></span>
        </span>
      </button>
    </div>
    <nav aria-label="Primary" class="hidden md:flex items-center gap-7 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "hover:text-grass transition-colors",
            current === link.href ? "text-forest font-medium" : "text-ink/70",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href="https://wa.me/91XXXXXXXXXX"
      class="hidden md:inline-flex items-center gap-1.5 rounded-full bg-grass px-5 py-2 text-sm text-white hover:bg-forest transition-colors"
    >
      WhatsApp Us
    </a>
    <nav id="mobile-menu" aria-label="Mobile primary" class="hidden border-t border-forest/10 pb-2 pt-3 md:hidden">
      <div class="grid gap-1 text-sm">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-xl px-3 py-2.5 hover:bg-forest/10 hover:text-grass transition-colors",
              current === link.href ? "bg-forest/5 text-forest font-medium" : "text-ink/70",
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href="https://wa.me/91XXXXXXXXXX"
          class="mt-2 inline-flex justify-center rounded-full bg-grass px-5 py-2.5 text-sm text-white hover:bg-forest transition-colors"
        >
          WhatsApp Us
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(
    'button[aria-controls="mobile-menu"]'
  );
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");

  menuButton?.addEventListener("click", () => {
    if (!mobileMenu) return;
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    menuButton.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
    mobileMenu.classList.toggle("hidden", isOpen);
  });
</script>
