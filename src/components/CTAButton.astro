---
interface Props {
  href: string;
  variant?: "solid" | "outline";
}
const { href, variant = "solid" } = Astro.props;
const styles =
  variant === "solid"
    ? "bg-forest text-paper hover:bg-grass hover:-translate-y-0.5 hover:shadow-soft"
    : "border border-forest text-forest hover:bg-forest hover:text-paper hover:-translate-y-0.5";
---

<a
  href={href}
  class:list={[
    "inline-block rounded-full px-7 py-3.5 text-sm font-medium transition-all duration-300",
    styles,
  ]}
>
  <slot />
</a>
