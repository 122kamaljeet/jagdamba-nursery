---
import { siteConfig, whatsappUrl } from "../environments/env";
const year = new Date().getFullYear();
---

<footer class="mt-24 mx-4">
  <div class="mx-auto  bg-forest text-paper px-8 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-lg">{siteConfig.name}</p>
        <p class="mt-2 text-sm text-paper/75 max-w-xs">
          Grass growers based in Ambala, Haryana — Selection No. 1, Korean,
          and Neelgiri grass, grown and cut fresh on our own fields.
        </p>
        <div class="mt-5 flex gap-3">
          <a href="#" aria-label="Instagram" class="h-9 w-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-grass transition-colors text-xs">IG</a>
          <a href="#" aria-label="Facebook" class="h-9 w-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-grass transition-colors text-xs">FB</a>
          <a href={whatsappUrl} aria-label="WhatsApp" class="h-9 w-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-grass transition-colors text-xs">WA</a>
        </div>
      </div>
      <div class="text-sm">
        <p class="font-medium mb-3">Contact</p>
        <p class="text-paper/75">{siteConfig.address}</p>
        <p class="text-paper/75">Phone: {siteConfig.phoneDisplay}</p>
        {siteConfig.email && <p class="text-paper/75">Email: {siteConfig.email}</p>}
        <p class="text-paper/75">{siteConfig.hours}</p>
        <a
          href="/jagdamba-nursery/contact#visit-us-heading"
          class="mt-2 inline-block text-paper underline underline-offset-4 hover:text-white"
        >
          Visit our locations
        </a>
      </div>
      <div class="text-sm">
        <p class="font-medium mb-3">Explore</p>
        <ul class="space-y-2 text-paper/75">
          <li><a href={`${siteConfig.base}/varieties`} class="hover:text-white">Our Grass Varieties</a></li>
          <li><a href={`${siteConfig.base}/gallery`} class="hover:text-white">Gallery</a></li>
          <li><a href={`${siteConfig.base}/blog`} class="hover:text-white">Guides</a></li>
          <li><a href={`${siteConfig.base}/contact`} class="hover:text-white">Request a Quote</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-paper/10 mt-10 pt-6 text-center text-xs text-paper/60">
      © {year} {siteConfig.name}. All rights reserved.
    </div>
  </div>
</footer>
